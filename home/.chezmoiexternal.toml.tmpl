# crush - https://github.com/charmbracelet/crush
[".local/bin/crush"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "charmbracelet/crush" "crush_*_Linux_x86_64.tar.gz" | quote }}
    executable = true
    stripComponents = 1
    path = "crush"

# delta - A syntax-highlighting pager for git and diff output
[".local/bin/delta"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "dandavison/delta" "delta-*-x86_64-unknown-linux-gnu.tar.gz" | quote }}
    executable = true
    stripComponents = 1
    path = "delta"

{{- end }}

{{- if and (not .ephemeral) (not .headless) }}
{{-   $fontDir := "" }}
{{-   if eq .chezmoi.os "darwin" }}
{{-     $fontDir = "Library/Fonts" }}
{{-   else if eq .chezmoi.os "linux" }}
{{-     $fontDir = ".local/share/fonts" }}
{{-   end }}
{{-   range (list
        "FiraCodeNerdFont-Bold.ttf"
        "FiraCodeNerdFont-Medium.ttf"
        "FiraCodeNerdFont-Retina.ttf"
        "FiraCodeNerdFont-Light.ttf"
        "FiraCodeNerdFont-Regular.ttf"
        "FiraCodeNerdFont-SemiBold.ttf") }}
["{{ $fontDir }}/{{ . }}"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "ryanoasis/nerd-fonts" "FiraCode.zip" | quote }}
    refreshPeriod = "168h"
    path =  {{ . | quote}}
{{-   end }}
{{- end }}



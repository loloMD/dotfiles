{{- if eq .chezmoi.os "linux" }}

{{- $arch := .chezmoi.arch -}}
{{- $isAmd64 := eq $arch "amd64" -}}
{{- $isArm64 := eq $arch "arm64" -}}
{{- $isArm := eq $arch "arm" -}}

{{- /* Common arch naming conventions used by various release assets */ -}}
{{- $x86_64OrArm64 := ternary "arm64" "x86_64" $isArm64 -}}
{{- $x86_64OrArm64Upper := ternary "ARM64" "64bit" $isArm64 -}}
{{- $rustArch := ternary "aarch64" "x86_64" $isArm64 -}}
{{- $brootArchDir := ternary "aarch64-unknown-linux-gnu" "x86_64-linux" $isArm64 -}}
{{- $starshipTarget := ternary "aarch64-unknown-linux-musl" "x86_64-unknown-linux-gnu" $isArm64 -}}
{{- $ezaTarget := "x86_64-unknown-linux-gnu" -}}
{{- if $isArm64 -}}
{{-   $ezaTarget = "aarch64-unknown-linux-gnu" -}}
{{- else if $isArm -}}
{{-   $ezaTarget = "arm-unknown-linux-gnueabihf" -}}
{{- end -}}

#A simple, modern and secure encryption tool (and Go library) with small explicit keys, no config options, and UNIX-style composability.
[".local/bin/age"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "FiloSottile/age" (printf "age-*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    executable = true
    path = "age/age"

[".local/bin/age-keygen"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "FiloSottile/age" (printf "age-*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    executable = true
    path = "age/age-keygen"

#  Easily and securely send things from one computer to another 🐊 📦 
[".local/bin/croc"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "schollz/croc" (printf "croc_v*_Linux-%s.tar.gz" $x86_64OrArm64Upper) | quote }}
    executable = true
    path = "croc"

# `eza`: modern replacement for `ls` (works on amd64/arm64 and more)
[".local/bin/eza"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "eza-community/eza" (printf "eza_%s.tar.gz" $ezaTarget) | quote }}
    executable = true
    path = "./eza"

